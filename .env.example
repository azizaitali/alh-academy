# MongoDB Connection URI (e.g. Local MongoDB or MongoDB Atlas URI)
# Example for local MongoDB: mongodb://127.0.0.1:27017/alh_academy
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/alh_academy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/alh_academy
MONGODB_DB=alh_academy

# Default Tikkie Payment URL (or set your custom active payment link)
NEXT_PUBLIC_DEFAULT_TIKKIE_URL=https://tikkie.me/pay/ALHAcademy/course-fee

# Admin Dashboard Password (protects /admin route and settings)
ADMIN_PASSWORD=admin123

# ABN AMRO Tikkie API v2 Credentials (used by Admin > Tikkie Payments page)
Api-Key=your_abn_amro_developer_api_key_here
X-App-Token=your_tikkie_app_token_uuid_here
PaymentRequestToken=your_payment_request_token_here

# Optional: Set to true if testing with sandbox endpoints (https://api-sandbox.abnamro.com/v2/tikkie)
# TIKKIE_SANDBOX=false

